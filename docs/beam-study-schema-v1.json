{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Beam study package v1",
  "type": "object",
  "required": [
    "exported_at",
    "project",
    "units",
    "projectors",
    "blend_groups",
    "screens",
    "receivers",
    "views",
    "optics",
    "surface_analysis",
    "warnings",
    "assumptions",
    "transform_validation",
    "schema",
    "schema_version"
  ],
  "properties": {
    "exported_at": {
      "type": "string",
      "format": "date-time"
    },
    "project": {
      "type": "object",
      "properties": {
        "project_name": {
          "type": "string"
        },
        "venue": {
          "type": "string"
        },
        "revision": {
          "type": "string"
        },
        "client": {
          "type": "string"
        },
        "author": {
          "type": "string"
        }
      },
      "required": [],
      "additionalProperties": true
    },
    "units": {
      "type": "object",
      "properties": {
        "internal_length": {
          "const": "m"
        },
        "display_length": {
          "enum": [
            "m",
            "mm"
          ]
        },
        "disguise_length": {
          "const": "mm"
        },
        "pixel_density": {
          "const": "px/m"
        },
        "pixel_size": {
          "const": "m/px"
        },
        "illuminance": {
          "const": "lux"
        },
        "coordinate_space": {
          "const": "blender_world"
        },
        "rotation": {
          "const": "degrees"
        },
        "quaternion": {
          "const": "unitless_wxyz"
        },
        "resolution": {
          "const": "px"
        },
        "luminous_flux": {
          "const": "lm"
        },
        "brightness": {
          "const": "percent"
        },
        "lens_shift": {
          "const": "percent_of_full_image"
        },
        "dpi": {
          "const": "px/in"
        },
        "overlap_by_input_mode": {
          "const": {
            "PIXELS": "px",
            "PERCENT": "percent",
            "METRES": "m"
          }
        }
      },
      "required": [
        "internal_length",
        "display_length",
        "disguise_length",
        "pixel_density",
        "pixel_size",
        "illuminance",
        "coordinate_space"
      ],
      "additionalProperties": true
    },
    "projectors": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/projector"
      }
    },
    "blend_groups": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/group"
      }
    },
    "screens": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "uuid",
          "name",
          "width_m",
          "height_m",
          "aspect",
          "notes"
        ],
        "properties": {
          "uuid": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "width_m": {
            "type": "number",
            "minimum": 0
          },
          "height_m": {
            "type": "number",
            "minimum": 0
          },
          "aspect": {
            "type": "number",
            "minimum": 0
          },
          "notes": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "receivers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "uuid",
          "name"
        ],
        "properties": {
          "uuid": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "views": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/view"
      }
    },
    "optics": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "projector_uuid",
          "model",
          "lens",
          "projector_preset",
          "lens_preset",
          "warnings"
        ],
        "properties": {
          "projector_uuid": {
            "type": "string",
            "format": "uuid"
          },
          "model": {
            "type": "string"
          },
          "lens": {
            "type": "string"
          },
          "projector_preset": {
            "type": [
              "object",
              "null"
            ]
          },
          "lens_preset": {
            "type": [
              "object",
              "null"
            ]
          },
          "warnings": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "surface_analysis": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "schema",
          "version",
          "receiver_uuid",
          "receiver_name",
          "projector_uuids",
          "statistics",
          "method",
          "visibility",
          "untested",
          "stale"
        ],
        "properties": {
          "schema": {
            "const": "beam-surface-analysis"
          },
          "version": {
            "const": 1
          },
          "receiver_uuid": {
            "type": "string",
            "format": "uuid"
          },
          "receiver_name": {
            "type": "string"
          },
          "projector_uuids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "format": "uuid"
            }
          },
          "statistics": {
            "type": "object",
            "required": [
              "surface_area_m2",
              "nominal_covered_area_m2",
              "visible_covered_area_m2",
              "coverage_percent",
              "uncovered_percent",
              "overlap_area_m2",
              "overlap_percent",
              "overlap_percent_of_covered",
              "density_min_px_m",
              "density_max_px_m",
              "density_average_px_m",
              "density_variation_percent",
              "max_anisotropy",
              "sample_count",
              "occluded_sample_count",
              "occluded_sample_percent"
            ],
            "properties": {
              "surface_area_m2": {
                "type": "number",
                "minimum": 0
              },
              "nominal_covered_area_m2": {
                "type": "number",
                "minimum": 0
              },
              "visible_covered_area_m2": {
                "type": "number",
                "minimum": 0
              },
              "coverage_percent": {
                "type": "number",
                "minimum": 0
              },
              "uncovered_percent": {
                "type": "number",
                "minimum": 0
              },
              "overlap_area_m2": {
                "type": "number",
                "minimum": 0
              },
              "overlap_percent": {
                "type": "number",
                "minimum": 0
              },
              "overlap_percent_of_covered": {
                "type": "number",
                "minimum": 0
              },
              "density_min_px_m": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0
              },
              "density_max_px_m": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0
              },
              "density_average_px_m": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0
              },
              "density_variation_percent": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0
              },
              "max_anisotropy": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0
              },
              "sample_count": {
                "type": "number",
                "minimum": 0
              },
              "occluded_sample_count": {
                "type": "number",
                "minimum": 0
              },
              "occluded_sample_percent": {
                "type": "number",
                "minimum": 0
              }
            }
          },
          "method": {
            "type": "string"
          },
          "visibility": {
            "type": "string"
          },
          "untested": {
            "type": "string"
          },
          "stale": {
            "const": false
          }
        }
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "code",
          "uuid",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "uuid": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          },
          "message": {
            "type": "string"
          }
        }
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "transform_validation": {
      "type": "object",
      "required": [
        "convention_id",
        "transform_convention",
        "validated",
        "mapping_matter_reference_validated"
      ],
      "properties": {
        "convention_id": {
          "const": "beam_mapping_matter_transform_v1"
        },
        "transform_convention": {
          "type": "string"
        },
        "validated": {
          "const": false
        },
        "mapping_matter_reference_validated": {
          "const": true
        }
      }
    },
    "schema": {
      "const": "beam-study"
    },
    "schema_version": {
      "const": "1.0.0"
    }
  },
  "additionalProperties": true,
  "$defs": {
    "matrix": {
      "type": "array",
      "items": {
        "type": "array",
        "items": {
          "type": "number"
        },
        "minItems": 4,
        "maxItems": 4
      },
      "minItems": 4,
      "maxItems": 4
    },
    "resolution": {
      "type": "object",
      "properties": {
        "x": {
          "type": "integer",
          "minimum": 1
        },
        "y": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "x",
        "y"
      ],
      "additionalProperties": true
    },
    "projector": {
      "type": "object",
      "properties": {
        "uuid": {
          "type": "string",
          "format": "uuid"
        },
        "name": {
          "type": "string"
        },
        "object_name": {
          "type": "string"
        },
        "include_in_disguise_export": {
          "type": "boolean"
        },
        "notes": {
          "type": "string"
        },
        "resolution": {
          "$ref": "#/$defs/resolution"
        },
        "throw_ratio": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "lens_shift_percent": {
          "type": "object",
          "properties": {
            "horizontal": {
              "type": "number"
            },
            "vertical": {
              "type": "number"
            },
            "basis": {
              "const": "full_image_dimensions"
            }
          },
          "required": [
            "horizontal",
            "vertical",
            "basis"
          ],
          "additionalProperties": true
        },
        "stack_quantity": {
          "type": "integer",
          "minimum": 1
        },
        "brightness_percent": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "nominal_lumens": {
          "type": "number",
          "minimum": 0
        },
        "total_lumens": {
          "type": "number",
          "minimum": 0
        },
        "position_m": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 3,
          "maxItems": 3
        },
        "rotation": {
          "type": "object",
          "properties": {
            "space": {
              "const": "blender_world"
            },
            "order": {
              "const": "XYZ"
            },
            "unit": {
              "const": "degrees"
            },
            "euler": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 3,
              "maxItems": 3
            }
          },
          "required": [
            "space",
            "order",
            "unit",
            "euler"
          ],
          "additionalProperties": true
        },
        "transform_valid": {
          "type": "boolean"
        },
        "target": {
          "type": "object",
          "properties": {
            "space": {
              "const": "blender_world"
            },
            "status": {
              "enum": [
                "hit",
                "no_hit"
              ]
            },
            "point_m": {
              "anyOf": [
                {
                  "type": "array",
                  "items": {
                    "type": "number"
                  },
                  "minItems": 3,
                  "maxItems": 3
                },
                {
                  "type": "null"
                }
              ]
            },
            "object_name": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "filter_object_name": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "automatic": {
              "const": true
            }
          },
          "required": [
            "status",
            "point_m",
            "object_name",
            "filter_object_name",
            "automatic"
          ],
          "additionalProperties": true
        },
        "calculated": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "throw_distance_m": {
                  "type": "number"
                },
                "centre_ray_distance_m": {
                  "type": "number"
                },
                "image_width_m": {
                  "type": "number"
                },
                "image_height_m": {
                  "type": "number"
                },
                "pixel_density_px_per_m": {
                  "type": "number"
                },
                "pixel_size_m_per_px": {
                  "type": "number"
                },
                "pixel_size_mm_per_px": {
                  "type": "number"
                },
                "dpi": {
                  "type": "number"
                },
                "estimated_illuminance_lux": {
                  "type": "number"
                }
              },
              "required": [
                "throw_distance_m",
                "centre_ray_distance_m",
                "image_width_m",
                "image_height_m",
                "pixel_density_px_per_m",
                "pixel_size_m_per_px",
                "pixel_size_mm_per_px",
                "dpi",
                "estimated_illuminance_lux"
              ],
              "additionalProperties": true
            },
            {
              "type": "null"
            }
          ]
        },
        "display_units": {
          "enum": [
            "m",
            "mm"
          ]
        },
        "study_colour_linear_rgb": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 3,
          "maxItems": 3
        },
        "study_colour_srgb": {
          "type": "array",
          "items": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "minItems": 3,
          "maxItems": 3
        },
        "study_colour_hex": {
          "type": "string",
          "pattern": "^#[0-9A-F]{6}$"
        },
        "output_mode": {
          "enum": [
            "SOLID",
            "GRID",
            "ID",
            "CHECKER",
            "UV_GRID",
            "COLOR_GRID",
            "IMAGE"
          ]
        },
        "visibility": {
          "type": "object",
          "properties": {
            "identifier": {
              "type": "boolean"
            },
            "projected_identifier": {
              "type": "boolean"
            },
            "frustum": {
              "type": "boolean"
            },
            "centre_ray": {
              "type": "boolean"
            },
            "target_marker": {
              "type": "boolean"
            },
            "grid": {
              "type": "boolean"
            },
            "output": {
              "type": "boolean"
            }
          },
          "required": [
            "identifier",
            "projected_identifier",
            "frustum",
            "centre_ray",
            "target_marker",
            "grid",
            "output"
          ],
          "additionalProperties": true
        }
      },
      "required": [
        "uuid",
        "name",
        "object_name",
        "include_in_disguise_export",
        "notes",
        "resolution",
        "throw_ratio",
        "lens_shift_percent",
        "stack_quantity",
        "brightness_percent",
        "nominal_lumens",
        "total_lumens",
        "position_m",
        "rotation",
        "transform_valid",
        "target",
        "calculated",
        "display_units",
        "study_colour_linear_rgb",
        "output_mode",
        "visibility"
      ],
      "additionalProperties": true,
      "allOf": [
        {
          "if": {
            "properties": {
              "target": {
                "properties": {
                  "status": {
                    "const": "no_hit"
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "calculated": {
                "type": "null"
              },
              "target": {
                "properties": {
                  "point_m": {
                    "type": "null"
                  },
                  "object_name": {
                    "type": "null"
                  }
                }
              }
            }
          },
          "else": {
            "properties": {
              "calculated": {
                "type": "object",
                "properties": {
                  "throw_distance_m": {
                    "type": "number"
                  },
                  "centre_ray_distance_m": {
                    "type": "number"
                  },
                  "image_width_m": {
                    "type": "number"
                  },
                  "image_height_m": {
                    "type": "number"
                  },
                  "pixel_density_px_per_m": {
                    "type": "number"
                  },
                  "pixel_size_m_per_px": {
                    "type": "number"
                  },
                  "pixel_size_mm_per_px": {
                    "type": "number"
                  },
                  "dpi": {
                    "type": "number"
                  },
                  "estimated_illuminance_lux": {
                    "type": "number"
                  }
                },
                "required": [
                  "throw_distance_m",
                  "centre_ray_distance_m",
                  "image_width_m",
                  "image_height_m",
                  "pixel_density_px_per_m",
                  "pixel_size_m_per_px",
                  "pixel_size_mm_per_px",
                  "dpi",
                  "estimated_illuminance_lux"
                ],
                "additionalProperties": true
              },
              "target": {
                "properties": {
                  "point_m": {
                    "type": "array",
                    "items": {
                      "type": "number"
                    },
                    "minItems": 3,
                    "maxItems": 3
                  },
                  "object_name": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      ]
    },
    "group": {
      "type": "object",
      "properties": {
        "uuid": {
          "type": "string",
          "format": "uuid"
        },
        "name": {
          "type": "string"
        },
        "layout": {
          "enum": [
            "HORIZONTAL",
            "VERTICAL",
            "ARRAY"
          ]
        },
        "anchor_projector_uuid": {
          "type": "string",
          "format": "uuid"
        },
        "rows": {
          "type": "integer",
          "minimum": 1
        },
        "columns": {
          "type": "integer",
          "minimum": 1
        },
        "input_mode": {
          "enum": [
            "PIXELS",
            "PERCENT",
            "METRES"
          ]
        },
        "desired_horizontal_overlap": {
          "type": "number"
        },
        "desired_vertical_overlap": {
          "type": "number"
        },
        "reference_plane": {
          "type": "object",
          "properties": {
            "role": {
              "const": "last_layout_reference_dimensions"
            },
            "distance_m": {
              "type": "number"
            },
            "width_m": {
              "type": "number"
            },
            "height_m": {
              "type": "number"
            }
          },
          "required": [
            "distance_m",
            "width_m",
            "height_m"
          ],
          "additionalProperties": true
        },
        "measurement_plane": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "space": {
                  "const": "blender_world"
                },
                "origin_m": {
                  "type": "array",
                  "items": {
                    "type": "number"
                  },
                  "minItems": 3,
                  "maxItems": 3
                },
                "rotation_quaternion_wxyz": {
                  "type": "array",
                  "items": {
                    "type": "number"
                  },
                  "minItems": 4,
                  "maxItems": 4
                },
                "status": {
                  "enum": [
                    "target",
                    "preview"
                  ]
                },
                "distance_m": {
                  "type": "number"
                },
                "width_m": {
                  "type": "number"
                },
                "height_m": {
                  "type": "number"
                }
              },
              "required": [
                "space",
                "origin_m",
                "rotation_quaternion_wxyz",
                "status",
                "distance_m",
                "width_m",
                "height_m"
              ],
              "additionalProperties": true
            },
            {
              "type": "null"
            }
          ]
        },
        "transform": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "space": {
                  "const": "blender_world"
                },
                "matrix": {
                  "$ref": "#/$defs/matrix"
                },
                "position_m": {
                  "type": "array",
                  "items": {
                    "type": "number"
                  },
                  "minItems": 3,
                  "maxItems": 3
                },
                "rotation_quaternion_wxyz": {
                  "type": "array",
                  "items": {
                    "type": "number"
                  },
                  "minItems": 4,
                  "maxItems": 4
                }
              },
              "required": [
                "position_m",
                "rotation_quaternion_wxyz"
              ],
              "additionalProperties": true
            },
            {
              "type": "null"
            }
          ]
        },
        "members": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "projector_uuid": {
                "type": "string",
                "format": "uuid"
              },
              "member_index": {
                "type": "integer",
                "minimum": 0
              },
              "row": {
                "type": "integer",
                "minimum": 0
              },
              "column": {
                "type": "integer",
                "minimum": 0
              },
              "local_offset_space": {
                "const": "projector_basis_relative_to_layout_slot"
              },
              "transform_in_group": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/matrix"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "layout_slot_transform": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/matrix"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "local_offset_m": {
                "anyOf": [
                  {
                    "type": "array",
                    "items": {
                      "type": "number"
                    },
                    "minItems": 3,
                    "maxItems": 3
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "local_rotation_quaternion_wxyz": {
                "anyOf": [
                  {
                    "type": "array",
                    "items": {
